{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Pyret reactor", "onAutoForward": "silent" }
  },
  "postAttachCommand": "bash .devcontainer/install-pyret-vsix.sh",
  "customizations": {
    "vscode": {
      "extensions": ["./pyret-parley-http.vsix"]
    },
    "codespaces": {
      "openFiles": ["server.arr"]
    }
  }
}
